; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpaceSim"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://game/main.tscn"

[autoload]

SpacesimSettings="*res://addons/spacesim/settings/settings.gd"

[rendering]

renderer/rendering_method="forward_plus"
; Lights are specified in physical units — lux for a directional light — rather than as a hand-tuned
; energy multiplier. Required by SpacesimStarLight: with this off, Godot ignores
; light_intensity_lux entirely and a star set from its real illuminance does nothing at all.
lights_and_shadows/use_physical_light_units=true
