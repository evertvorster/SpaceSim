[resource]
script = ExtResource("system")
content_version = 1
epoch = ""
framing = SubResource("Framing_playground")
start_body_id = "planet:terra"
start_altitude = 20000000.0
start_world_time = 0.0
bodies = Array[ExtResource("body")]([SubResource("B_helios"), SubResource("B_cinder"), SubResource("B_terra"), SubResource("B_borealis"), SubResource("B_nix")])
