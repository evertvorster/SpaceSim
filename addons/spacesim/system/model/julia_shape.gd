class_name SpacesimJuliaShape
extends RefCounted
## **A rough body, generated by sweeping a Julia set.** Evert, 2026-11-08: *"You could use a sweeped Julia to
## generate the rough shape... anything but a sphere."*
##
## ## Why this and not a sphere with bumps
##
## Every attempt before this started from an icosphere and scaled its vertices, which is sphere-first: the
## topology, the triangle distribution and the *base solid* were all a sphere, and the body was a deformation of
## one. That is fine for a planet, where the base really is a sphere, and wrong for a rock — Evert, repeatedly:
## *"I keep telling you, we need a different shape than a sphere as a starting point."*
##
## Here the base surface **is** the generated shape:
##
## 1. a **2D Julia set** — the boundary of the escaping region of `z -> z² + c` — gives a lumpy, closed, fractal
##    outline. The constant `c` is seeded per body, so no two bodies share an outline;
## 2. that outline is **swept along the body's long axis**, with a profile that tapers to nothing at both ends
##    and a seeded twist, which closes it into a solid.
##
## Nothing is a sphere and nothing is a deformation of one: the outline is fractal, the sweep is not radial, and
## the result is genuinely irregular at every scale rather than at the scales a Fourier sum allowed.
##
## ## What it costs
##
## One escape-time march per outline point, then a grid of surface points — a few hundred thousand iterations for
## a body, once, at build. Cheap enough that a belt's fragments could each afford one.
##
## ## What it is not
##
## Not a volumetric fractal: a Julia set in 3D would need marching cubes to get a surface, and that is a different
## and much more expensive mechanism. This sweeps a 2D outline, which gives a closed star-shaped solid — a rock,
## not a coral. Overhangs and contact binaries need the volumetric version, and that is a later step.

## How many points around the outline.
const OUTLINE_POINTS := 180
## How many rings along the sweep.
const RINGS := 96
## How far out the escape-time march looks, as a fraction of the body's radius.
const MAX_REACH := 1.0
## The iteration cap. `c` values that do not escape within this are treated as inside the set.
const ITERATIONS := 64

## **How much of the body's own reach a cross-section must keep to count as a rock.** A Julia constant picked at
## random gives a thin filament as readily as a lump, and a filament has no rock in it to stand on, let alone mine.
## Evert, 2026-11-08: *"Just have to be careful which bit of the Julia we pick, so has to have a certain volume."*
##
## Measured as the mean of `r²/MAX_REACH²` round the outline — the share of a circle's area the cross-section keeps
## — so it is a volume proxy with no integration in it.
const MIN_VOLUME_SHARE := 0.18

## **And how lumpy it may be.** A cross-section whose longest ray is more than this many times its shortest is a
## spike or a starfish: irregular enough to read as noise rather than as a body. **3.0, because the fallback bites**:
## when no candidate passes, the most voluminous one is used, and at 2.6 some seeds had no candidate at all — Phobos
## came out at 2.67 on the sweep's own resolution.
const MAX_RADIUS_RATIO := 3.0


## **The 2D Julia outline, as radii per angle** — one march per angle, and the radius is the last one still
## bounded. `c` is seeded, so every body gets its own curve: some are lumpy, some are almost polygonal, and a few
## are near-circles, which is what a population of rocks actually looks like.
static func outline(seed_value: int) -> PackedFloat32Array:
	return _radii_for(_pick(seed_value), OUTLINE_POINTS)


## **The radii around one Julia constant**, marched outward from the centre along each ray: the furthest radius still
## inside the set. Marching from the centre is what makes a body star-shaped about its axis — see the header.
static func _radii_for(c: Vector2, count: int) -> PackedFloat32Array:
	var radii := PackedFloat32Array()
	radii.resize(count)
	for index in count:
		var angle := TAU * float(index) / float(count)
		var direction := Vector2(cos(angle), sin(angle))
		var inside := 0.0
		var steps := 48
		for step in steps:
			var r := MAX_REACH * float(step + 1) / float(steps)
			if _bounded(c + direction * (r * 1.6), c):
				inside = r
			else:
				break
		radii[index] = maxf(inside, 0.04)
	return radii


## **One point on the body's surface**, in metres from its centre. `u` runs around the sweep, `v` along it.
##
## The profile is what closes the ends: the outline's radius is multiplied by a curve that is zero at `v = 0` and
## `v = 1` and largest in the middle, and by a seeded lobe that makes each end different from the other — a body
## that tapered symmetrically would read as a manufactured shape rather than a broken one.
static func surface_point(
	seed_value: int, radius: float, u: float, v: float, radii: PackedFloat32Array
) -> Vector3:
	var count := radii.size()
	var uu := fposmod(u, 1.0)
	var index := int(uu * float(count)) % count
	var next := (index + 1) % count
	var frac := uu * float(count) - float(index)
	var outline_radius := lerpf(radii[index], radii[next], frac)
	# Along the sweep: a body is longer than it is wide, and the ends round off rather than meeting at a point.
	var length := radius * lerpf(1.55, 2.05, _unit(seed_value, 3))
	var along := (v - 0.5) * length
	var taper := sin(PI * v)
	taper = pow(maxf(taper, 0.0), lerpf(0.45, 0.75, _unit(seed_value, 4)))
	# A twist along the axis, so the outline does not sweep in parallel and the body does not look extruded.
	var twist := (v - 0.5) * lerpf(-1.2, 1.2, _unit(seed_value, 5))
	var angle := TAU * uu + twist
	var width := radius * outline_radius * taper
	return Vector3(cos(angle) * width, along, sin(angle) * width)


## **The body as a mesh**, with the sweep's own normals — from the surface, not from a direction, so the shading
## shows the lumpiness instead of a sphere's.
## `detail` multiplies the grid in both directions. **Subdividing is what approaches the true shape**: every new
## vertex is evaluated ON the surface, so a refinement is not an interpolation of the coarse mesh but a finer sampling
## of the same body — Evert, 2026-11-08: *"When we subdivide that, we can get closer and closer to the true shape
## with the subdivisions."* The chord error falls as the square of the step, which `tests/test_surface_field.gd`
## measures rather than assumes.
##
## `wire` builds the SAME grid as `PRIMITIVE_LINES` instead — the debug view's product, and it has to be built here
## because a wireframe in this engine is a mesh and not a material: a body with no walk has no other source of one.
static func mesh(seed_value: int, radius: float, detail := 1, wire := false) -> ArrayMesh:
	var radii := outline(seed_value)
	var points := OUTLINE_POINTS * maxi(detail, 1)
	var rings := RINGS * maxi(detail, 1)
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var indices := PackedInt32Array()
	vertices.resize(points * rings)
	normals.resize(points * rings)
	for ring in rings:
		var v := float(ring) / float(rings - 1)
		for point in points:
			var u := float(point) / float(points)
			var index := ring * points + point
			var here := surface_point(seed_value, radius, u, v, radii)
			vertices[index] = here
			# The normal, differenced along the surface rather than taken as the direction: this is what makes the
			# shape read as a shape instead of as a sphere with a radial gradient.
			var du := surface_point(seed_value, radius, u + 1.0 / float(points), v, radii) - here
			var dv := surface_point(
				seed_value, radius, u, minf(v + 1.0 / float(rings - 1), 1.0), radii
			) - here
			var normal := du.cross(dv)
			normals[index] = normal.normalized() if normal.length_squared() > 0.0 else here.normalized()
	for ring in rings - 1:
		for point in points:
			var next_point := (point + 1) % points
			var a := ring * points + point
			var b := ring * points + next_point
			var c := (ring + 1) * points + point
			var d := (ring + 1) * points + next_point
			if wire:
				# **Both directions of the grid and no diagonals.** A wireframe's job is to show the tessellation, so
				# what it draws is the sampling: rings along the sweep, points around it.
				indices.append_array([a, b, a, c])
			else:
				indices.append_array([a, c, b, b, c, d])
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	# **No normals on the wireframe** — the material is unshaded white, so a normal per vertex would be bytes
	# nothing reads. The same rule the walk's own line mesh follows.
	if not wire:
		arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_INDEX] = indices
	var result := ArrayMesh.new()
	result.add_surface_from_arrays(Mesh.PRIMITIVE_LINES if wire else Mesh.PRIMITIVE_TRIANGLES, arrays)
	return result


## **How far the body reaches in a direction** — the datum question, answered from the same surface the mesh is
## built from: the sweep is searched for the point nearest that direction.
##
## A marching search rather than an inversion, because the sweep has no closed form for "radius in a direction",
## and the callers that need it (altitude, proximity) are per tick rather than per pixel.
static func radius_at(seed_value: int, radius: float, direction: Vector3) -> float:
	var radii := outline(seed_value)
	var best := 0.0
	var best_dot := -2.0
	var dir := direction.normalized()
	for ring in 24:
		var v := float(ring) / 23.0
		for point in 36:
			var u := float(point) / 36.0
			var here := surface_point(seed_value, radius, u, v, radii)
			var length := here.length()
			if length <= 0.0:
				continue
			var alignment := here.dot(dir) / length
			if alignment > best_dot:
				best_dot = alignment
				best = length
	return best


## **Is this point still in the set after `ITERATIONS`?**
static func _bounded(point: Vector2, c: Vector2) -> bool:
	var z := point
	for _step in ITERATIONS:
		z = Vector2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c
		if z.length_squared() > 4.0:
			return false
	return true


## **A constant that gives a BODY, not a filament.** Candidates are drawn from the interesting part of the
## Mandelbrot boundary, where Julia sets are fractal curves rather than dust, and each is measured at low resolution:
## one is accepted if it keeps [constant MIN_VOLUME_SHARE] of its reach and stays under
## [constant MAX_RADIUS_RATIO]. If none passes, the most voluminous candidate is used — a body with a thin spot beats
## a body that is not there.
##
## **The measurement is the point, not the search**: it means "how much of the Julia is a rock" is answered by the
## shape rather than by which constant looked good once.
static func _pick(seed_value: int) -> Vector2:
	var best := Vector2(-0.4, 0.5)
	var best_share := -1.0
	for attempt in 24:
		var c := Vector2(
			lerpf(-0.86, -0.30, _unit(seed_value, 1 + attempt * 2)),
			lerpf(-0.52, 0.52, _unit(seed_value, 2 + attempt * 2))
		)
		var candidate := _radii_for(c, OUTLINE_POINTS)
		var share := volume_share(candidate)
		if share <= best_share:
			continue
		best_share = share
		best = c
		if _passes(candidate):
			return c
	return best


## **The share of a circle's area a cross-section keeps** — the volume proxy, mean of `r²/MAX_REACH²`.
static func volume_share(radii: PackedFloat32Array) -> float:
	if radii.is_empty():
		return 0.0
	var total := 0.0
	for r in radii:
		total += (r / MAX_REACH) * (r / MAX_REACH)
	return total / float(radii.size())


## Whether an outline is a body by the two tests above.
static func _passes(radii: PackedFloat32Array) -> bool:
	if radii.is_empty():
		return false
	var shortest := INF
	var longest := 0.0
	for r in radii:
		shortest = minf(shortest, r)
		longest = maxf(longest, r)
	return (
		volume_share(radii) >= MIN_VOLUME_SHARE
		and longest / maxf(shortest, 1.0e-5) <= MAX_RADIUS_RATIO
	)


static func _unit(seed_value: int, salt: int) -> float:
	var mixed := (seed_value ^ (salt * 2654435761)) & 0x7fffffff
	return float(mixed % 100000) / 100000.0
