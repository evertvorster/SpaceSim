;
; **A trace species that carries Earth's entire visible absorption.** Its Rayleigh scattering is three
; orders below nitrogen's at the same wavelengths *and* it is present at 0.4 parts per million, so it is
; left at zero -- a statement about the mix, not a missing measurement. Its IR greenhouse is likewise
; left at zero and IS a gap, but a harmless one: at this mole fraction it could not move Earth's 288 K
; calibration either way.
[sub_resource type="Resource" id="Sp_ozone"]
script = ExtResource("species")
species_name = "ozone"
domain = 2
density = 2.144
molar_mass = 47.998
heat_capacity = 820.0
