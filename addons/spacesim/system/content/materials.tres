[gd_resource type="Resource" script_class="SpacesimMaterialTable" format=3]

[ext_resource type="Script" path="res://addons/spacesim/system/content/material_table.gd" id="table"]
[ext_resource type="Script" path="res://addons/spacesim/system/content/species.gd" id="species"]

; The substances a system's compositions name. Ships with the engine: changing the density of iron
; changes physics, not art. A system may extend it.
;
; Density and molar mass are standard physical values. `albedo` is the material's Bond albedo and
; `color` its visual colour, both used by the surface derivation. Condensation temperatures are at
; one atmosphere. `rayleigh` and `greenhouse` are deliberately EMPTY: the sky and the greenhouse
; need wavelength-resolved data, and a guessed cross-section would be worse than an absent one.

[sub_resource type="Resource" id="Sp_iron"]
script = ExtResource("species")
species_name = "iron"
domain = 0
density = 7874.0
molar_mass = 55.845
albedo = 0.1
color = Color(0.55, 0.5, 0.47, 1)
condensation_temperature = 1811.0

