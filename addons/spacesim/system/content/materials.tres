[gd_resource type="Resource" script_class="SpacesimMaterialTable" format=3]

[ext_resource type="Script" path="res://addons/spacesim/system/content/material_table.gd" id="table"]
[ext_resource type="Script" path="res://addons/spacesim/system/content/species.gd" id="species"]

; The substances a system's compositions name. Ships with the engine: changing the density of iron
; changes physics, not art. A system may extend it.
;
; Density and molar mass are standard physical values. `albedo` is the material's Bond albedo and
; `color` its visual colour, both used by the surface derivation. Condensation temperatures are at
; one atmosphere.
;
; `rayleigh` is the per-channel Rayleigh scattering cross-section, in square metres per molecule, at
; three channel wavelengths (680, 550 and 440 nm). It is populated for the gases the authored
; atmospheres are actually made of, and the derivation sums each species' cross-section times its
; number density to get the mix's coefficient — see `SpacesimAtmosphereModel`.
;
; SOURCE. Six are **computed, not recalled**, from the refractive-index dispersion relations and
; King correction factors in Table 1 of Wilmouth & Sayres (2019), JQSRT 234, 32-39, using the n-based
; cross-section expression from Sneep & Ubachs (2005), JQSRT 92, 293-310. Methane uses Wilmouth &
; Sayres' own corrected dispersion (their Eq. 4), which is 22% below the older published one.
;
; Two are literature values taken at face value. **Oxygen** (4.0e-31 m^2 at 550 nm, scaled by
; wavelength to the fourth). **Hydrogen**, computed with the equivalent dilute-gas form
; `sigma = (32 pi^3 / 3 lambda^4) ((n-1)/N0)^2 * 3/(3 - 4 rho_v)` from (n-1) = 1.320e-4 at 0 C and a
; depolarisation ratio of 0.011 — and that form was **checked against helium before it was used**,
; where a dispersion relation does exist: it reproduces the n-based value to four digits (6.7823e-33
; against 6.782e-33), so hydrogen sits on the same footing as the rest.
;
; **Close enough is the standard here** — the guard is that Earth's mixture lands on the published
; effective coefficient, which `tests/test_render.gd` asserts.
; `greenhouse` is the **grey infrared mass-absorption coefficient**, m^2/kg, one band per entry --
; the array being where more bands would go. **Each value is fixed against one measured surface
; temperature**, which is the honest way to say it: water vapour against Earth's 288 K, CO2 against
; Venus's 737 K, methane against Titan's 94 K. Nothing else was tuned.
;
; Two things make that a calibration rather than a fit. N2, O2, Ar, He and H2 are explicitly **zero** --
; transparent in the infrared, which is correct and is why Earth's air is warmed by its water vapour
; and not by the nitrogen that makes up 78% of it. And after those three constants are fixed, **Mars
; and Triton are untouched checks**: Mars comes out 213 K against ~210 (its residual is the albedo,
; not the greenhouse) and Triton 37 against 38. The ordering is right too -- water vapour absorbs far
; more per kilogram than methane, and methane more than CO2.

;
; VISIBLE ABSORPTION, `absorption`, is the per-channel **absorption** cross-section in square metres per
; molecule at the same 680, 550 and 440 nm as `rayleigh`, and it is what makes a sky's extinction larger
; than its scattering. Unlike the IR `greenhouse` it says what SUNLIGHT is lost to, and it is what gives
; the mix its single-scattering albedo `w = sigma_scatter / sigma_extinct` -- the number that decides
; whether a thick air behaves like a mirror or like a filter.
;
; The gases that absorb visible light are ozone, methane and NO2. **CO2, N2 and O2 are transparent right
; through the visible**, so no amount of absorption data will darken Venus; its air has nothing to
; absorb with and its darkness is geometry and multiple scattering.
;
; **Ozone is measured, not recalled.** SOURCE: Serdyuchenko, Gorshelev, Weber, Chehade & Burrows (2014),
; Atmos. Meas. Tech. 7, 609-624, high spectral resolution ozone cross-sections; the data set itself is
; the Zenodo deposit the IUP Bremen group publishes (doi:10.5281/ZENODO.5793206), read at 0.01 nm over
; 213-1100 nm. The **223 K** column is used, because that is the temperature of the ozone layer rather
; than of the air at the ground -- the Chappuis band's own temperature dependence is under 1% between
; 193 and 293 K, so the choice is almost free, but 223 K is the honest one. Values are **vacuum
; wavelengths**, which sit within 0.2 nm of the air wavelengths the engine's channels are named at.
; The band peaks at 5.15e-21 cm2/molecule at 603 nm, and a 300 DU column comes to 2.6% absorbed at
; 550 nm -- which is the check the table is judged against, rather than the values being taken on trust.
;
; Methane's visible bands (619, 665.7 and 703.6 nm, for Titan) are **not in yet**. That is a named gap:
; zero here means the species is transparent at that wavelength, per the rule `rayleigh` already follows.

[sub_resource type="Resource" id="Sp_iron"]
script = ExtResource("species")
species_name = "iron"
domain = 0
density = 7874.0
molar_mass = 55.845
albedo = 0.1
color = Color(0.55, 0.5, 0.47, 1)
condensation_temperature = 1811.0

